# Frontend API Base URL Configuration
# Leave empty for local development to use the Vite proxy (/api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=

# For direct local connection without proxy:
# VITE_API_BASE_URL=http://127.0.0.1:8000

# For production cloud deployment:
# VITE_API_BASE_URL=https://your-backend-api.onrender.com

# 1-Click Demo Evaluation Mode
# true: shows demo persona switcher
# false: uses normal production login
VITE_DEMO_MODE=true
