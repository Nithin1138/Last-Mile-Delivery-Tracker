# Database
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/delivery_tracker
TEST_DATABASE_URL=postgresql://your_user:your_password@localhost:5432/delivery_tracker_test

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Notifications (Email & SMS — optional; console provider used if not configured)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
# Resend free tier only sends to the account owner's email.
# Set this to your Resend account email to receive all notifications during testing.
RESEND_TEST_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio trial accounts require verified caller IDs.
# Set this to your verified mobile number to receive all SMS alerts during testing.
TWILIO_TEST_PHONE=

# CORS

CORS_ORIGINS=http://localhost:5173

# App
APP_ENV=development
