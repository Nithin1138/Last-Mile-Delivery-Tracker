# Database Configuration
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/delivery_tracker
TEST_DATABASE_URL=postgresql://your_user:your_password@localhost:5432/delivery_tracker_test

# JWT Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Transactional Email Notifications (Optional: Console provider used by default for local evaluation)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev
# On free/trial Resend accounts, set your verified account email to receive notifications
RESEND_TEST_EMAIL=

# CORS Configuration
CORS_ORIGINS=http://localhost:5173

# Application Environment
APP_ENV=development

