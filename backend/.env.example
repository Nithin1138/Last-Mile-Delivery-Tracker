# Database
DATABASE_URL=postgresql://your_user:your_password@localhost:5432/delivery_tracker
TEST_DATABASE_URL=postgresql://your_user:your_password@localhost:5432/delivery_tracker_test

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Notifications (optional — console provider used if not set)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=onboarding@resend.dev

# CORS
CORS_ORIGINS=http://localhost:5173

# App
APP_ENV=development
